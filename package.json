{
  "name": "mundi",
  "version": "0.1.0",
  "private": true,
  "description": "MUNDI — Comprendre le monde. Prototype web (MVP).",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/serve-static.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "validate:editorial": "node scripts/validate-editorial.mjs",
    "media:generate": "node scripts/generate-demo-media.mjs",
    "test:e2e": "playwright test",
    "sources:collect": "node scripts/collect-sources.mjs",
    "test:sources": "node --test tests/collect-sources.test.mjs tests/editorial-report.test.mjs tests/editorial-manual.test.mjs tests/editorial-candidates.test.mjs tests/source-health.test.mjs tests/review-packs.test.mjs tests/story-preview.test.mjs",
    "sources:report": "node scripts/render-editorial-report.mjs",
    "icons:generate": "node scripts/generate-icons.mjs",
    "sources:run": "node scripts/run-editorial-inbox.mjs",
    "sources:candidates": "node scripts/export-candidates.mjs",
    "test:reviews": "node --test tests/review-packs.test.mjs",
    "validate:reviews": "node scripts/validate-review-packs.mjs",
    "preview:story": "node scripts/build-story-preview.mjs",
    "test:story": "node --test tests/story-preview.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3"
  }
}
