// MUNDI sur Cloudflare Workers : adresse officielle https://mundi.nadaudjacques004.workers.dev (#129).
// Build : `npm run build` (export Next.js dans out/, plus out/_redirects généré depuis netlify.toml).
// Déploiement : `npx wrangler deploy` publie out/ comme fichiers statiques, et worker/index.mjs pour /api/*.
// Notifications : secrets VAPID_PUBLIC_KEY et VAPID_PRIVATE_KEY (tableau de bord Cloudflare, Settings >
// Variables and Secrets, type « Secret »). Sans eux, /api/push répond { enabled: false } et le site
// affiche « Indisponibles pour l'instant ». Voir docs/CLOUDFLARE.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mundi",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Seules les adresses /api/* passent par le Worker ; tout le reste est servi tel quel.
    "run_worker_first": ["/api/*"]
  },
  // Abonnements aux notifications : un Durable Object au stockage SQLite (offre gratuite comprise).
  "durable_objects": {
    "bindings": [{ "name": "PUSH_HUB", "class_name": "PushHub" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PushHub"] }],
  // Toutes les 10 minutes : annonce aux abonnés une édition nouvellement en ligne (au plus une par heure).
  "triggers": { "crons": ["*/10 * * * *"] },
  "observability": { "enabled": true }
}
